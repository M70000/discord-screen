# Token do Bot do Discord (obtido no Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=seu_token_aqui

# Application ID / Client ID do Bot (obtido no Discord Developer Portal -> General Information)
CLIENT_ID=seu_client_id_aqui

# ID do Servidor de testes (Opcional - se preenchido, registra os comandos instantaneamente neste servidor; se vazio, registra globalmente)
GUILD_ID=
