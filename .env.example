# Token do Bot do Discord (obtido no Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=seu_token_aqui

# Application ID / Client ID do Bot (obtido no Discord Developer Portal -> General Information)
CLIENT_ID=seu_client_id_aqui

# ID do Servidor de testes (Opcional - se preenchido, registra os comandos instantaneamente neste servidor; se vazio, registra globalmente)
GUILD_ID=

# Porta do Servidor HTTP integrado (para webhooks e Player Web)
PORT=3000

# URL Base pública do Bot (ex: http://localhost:3000 ou https://seu-bot.onrender.com)
BASE_URL=http://localhost:3000

# Chave secreta compartilhada para os webhooks do OBS (deve ser a mesma no script do OBS)
OBS_WEBHOOK_SECRET=sua_chave_secreta_aqui

# ID do canal de anúncio padrão para abertura direta pelo OBS (ex: 1550319455727525908)
ANNOUNCEMENT_CHANNEL_ID=1550319455727525908

# Nome do canal de texto alternativo para busca por nome (caso o ID não esteja preenchido)
ANNOUNCEMENT_CHANNEL_NAME=telamento
